{
	"name": "wktree-lake",
	"private": true,
	"type": "module",
	"scripts": {
		"fmt": "oxfmt --config ../.oxfmtrc.json --disable-nested-config .",
		"fmt:check": "oxfmt --check --config ../.oxfmtrc.json --disable-nested-config .",
		"lint": "oxlint --deny-warnings .",
		"typecheck": "tsc --noEmit -p tsconfig.json",
		"check": "bun run fmt:check && bun run lint && bun run typecheck"
	},
	"dependencies": {
		"@botlake/core": "0.2.1",
		"@botlake/extension-agents": "0.2.0",
		"@botlake/extension-batteries": "0.2.0",
		"@botlake/extension-ct-config": "0.2.0",
		"@botlake/extension-flags": "0.2.0",
		"@botlake/extension-identity": "0.2.0",
		"@botlake/extension-references": "0.2.0",
		"@botlake/extension-work": "0.2.0",
		"@botlake/extension-work-agents": "0.2.0",
		"@botlake/native-session": "0.2.0"
	}
}
